<Project Sdk="Microsoft.NET.Sdk">
  <!-- Built against .NET Framework 4.8, which ships with Windows 10/11: no runtime to install. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>ibra-ext-installer</AssemblyName>
    <RootNamespace>IbraAntivirus.ExtInstaller</RootNamespace>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>IBRA ANTIVIRUS</Product>
    <Company>IBRAPROGRAM</Company>
    <Copyright>برمجة وتطوير ابراهيم الخزرجي</Copyright>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="WindowsBase" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
